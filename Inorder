class Node:
    def __init__(self, val):
        self.val = val
        self.left = None
        self.right = None


def inorder(root):
    if root is None:
        return

    inorder(root.left)
    print(root.val, end=" ")
    inorder(root.right)


# Sample input: Binary tree [1, 2, 3]
root = Node(1)
root.left = Node(2)
root.right = Node(3)

inorder(root)
